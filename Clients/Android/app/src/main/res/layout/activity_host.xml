<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HostActivity">

    <!-- Top Header & End Game Button -->
    <TextView
        android:id="@+id/tvHostTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/host_control"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center_horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btEndGame"
        app:layout_constraintTop_toTopOf="@id/btEndGame"
        app:layout_constraintBottom_toBottomOf="@id/btEndGame"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btEndGame"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lb_end_game"
        android:layout_margin="20dp"
        android:textColor="@color/color_red"
        app:strokeColor="@color/color_red"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Player Lock-In Status Row -->
    <LinearLayout
        android:id="@+id/llStatusRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/btEndGame"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvChallengerStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/dr_border_rounded_red"
            android:backgroundTint="#334155"
            android:gravity="center"
            android:padding="10dp"
            android:text="@string/lb_player_status"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChaserStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:background="@drawable/dr_border_rounded_red"
            android:backgroundTint="#334155"
            android:gravity="center"
            android:padding="10dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 5-Second Lockout Countdown Bar -->
    <ProgressBar
        android:id="@+id/pbLockoutTimer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp"
        android:max="500"
        android:progress="500"
        android:progressTint="@color/color_red"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/llStatusRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Question Display (High Contrast for Cold Reading) -->
    <TextView
        android:id="@+id/tvQuestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/lb_waiting"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="26sp"
        app:autoSizeStepGranularity="2sp"
        app:layout_constraintTop_toBottomOf="@id/pbLockoutTimer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Non-Interactive Answer Preview Cards (Mirrors Player Screen) -->
    <LinearLayout
        android:id="@+id/llAnswers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@id/llRevealControls"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvOptionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dr_background_card"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOptionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/dr_background_card"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvOptionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dr_background_card"
            android:padding="14dp"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Step 1: Sequential Reveal Buttons -->
    <LinearLayout
        android:id="@+id/llRevealControls"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"

        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btNextQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btRevealChallenger"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/color_blue"
            android:enabled="false"
            android:text="@string/lb_challenger"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btRevealCorrect"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:backgroundTint="@color/color_green"
            android:enabled="false"
            android:text="@string/lb_correct"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btRevealChaser"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:backgroundTint="@color/color_red"
            android:enabled="false"
            android:text="@string/lb_chaser"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- Step 2: Advance to Next Question -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btNextQuestion"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:enabled="false"
        android:text="@string/lb_next_question"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>