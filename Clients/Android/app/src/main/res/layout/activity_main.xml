<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">


    <EditText
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:padding="10dp"
        android:id="@+id/etEndpoint"
        android:inputType="textUri"
        android:text="ws://"
        android:textSize="17sp"
        android:background="@drawable/dr_border_rounded_blue"
        android:autofillHints="no"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.2"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/etEndpoint"
        android:background="@color/white"
        android:text="@string/lb_endpoint"
        android:textSize="17sp"
        android:layout_marginBottom="-13dp"
        android:layout_marginStart="10dp"
        android:padding="5dp"
        app:layout_constraintBottom_toTopOf="@id/etEndpoint"
        app:layout_constraintStart_toStartOf="@id/etEndpoint" />

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rgRoleSelect"
        android:layout_marginTop="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:padding="10dp"
        android:checkedButton="@id/rbPlayerStation"
        android:background="@drawable/dr_border_rounded_blue"
        app:layout_constraintStart_toStartOf="@id/etEndpoint"
        app:layout_constraintEnd_toEndOf="@id/etEndpoint"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintTop_toBottomOf="@id/etEndpoint">

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rbPlayerStation"
            android:checked="true"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/lb_challenger_station"
            android:textSize="17sp"/>

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/rbChaserStation"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="@string/lb_chaser_station"
            android:textSize="17sp"/>

        <RadioButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:id="@+id/rbHostStation"
            android:text="@string/lb_host_station"
            android:textSize="17sp"/>

    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:labelFor="@id/rgRoleSelect"
        android:layout_marginBottom="-13dp"
        android:layout_marginStart="10dp"
        android:background="@color/white"
        android:text="@string/lb_role_select"
        android:textSize="17sp"
        android:padding="5dp"
        app:layout_constraintBottom_toTopOf="@id/rgRoleSelect"
        app:layout_constraintStart_toStartOf="@id/etEndpoint" />

    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:id="@+id/btConnect"
        android:layout_marginTop="50dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        android:text="@string/lb_connect"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="@id/etEndpoint"
        app:layout_constraintEnd_toEndOf="@id/etEndpoint"
        app:layout_constraintTop_toBottomOf="@id/rgRoleSelect"/>

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/pbProgressIndicator"
        android:indeterminate="true"
        android:indeterminateTint="@color/color_blue"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btConnect"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>